{
  "general": {
    "configs_folder": "/opt/janus/etc/janus",  // Configuration files folder
    "plugins_folder": "/opt/janus/lib/janus/plugins",  // Plugins folder
    "transports_folder": "/opt/janus/lib/janus/transports",  // Transports folder
    "events_folder": "/opt/janus/lib/janus/events",  // Event handlers folder (replace @eventdir@)
    "loggers_folder": "/opt/janus/lib/janus/loggers",  // External loggers folder

    "debug_level": 4,  // Debug/logging level, valid values are 0-7
    // Uncomment and set log_to_file if you want to log to a file
    // "log_to_file": "/path/to/janus.log",  // Log file path
    // "log_to_stdout": true,  // Whether to log to stdout (default=true)

    "admin_secret": "janusoverlord",  // Admin API secret
    // Uncomment to enable token-based authentication
    // "token_auth": true,
    // "token_auth_secret": "janus",

    // Uncomment to run Janus as a daemon
    // "daemonize": true,
    // "pid_file": "/path/to/janus.pid"  // PID file path
  },

  "certificates": {
    // Uncomment and set paths if you want to use custom certificates
    // "cert_pem": "/path/to/certificate.pem",
    // "cert_key": "/path/to/key.pem",
    // "cert_pwd": "secretpassphrase",
    // "dtls_accept_selfsigned": false
  },

  "media": {
    // Uncomment to enable IPv6 support
    // "ipv6": true,
    // "rtp_port_range": "20000-40000"  // RTP port range
  },

  "nat": {
    // Uncomment and set your STUN server
    // "stun_server": "stun.l.google.com",
    // "stun_port": 19302,
    "ice_ignore_list": "vmnet"  // Ignore VMware interfaces
  },

  "plugins": {
    // Uncomment to disable specific plugins
    // "disable": "libjanus_echotest.so,libjanus_recordplay.so"
  },

  "transports": {
    // Uncomment to disable specific transports
    // "disable": "libjanus_rabbitmq.so"
  },

  "loggers": {
    // Uncomment to disable specific loggers
    // "disable": "libjanus_jsonlog.so"
  },

  "events": {
    // Uncomment to enable event broadcasting
    // "broadcast": true,
    // "stats_period": 5  // Period for media statistics
  }
}